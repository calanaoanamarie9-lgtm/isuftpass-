APP_NAME=ISUFSTPASS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-production-domain.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------
# Supabase PostgreSQL
# Copy values from Supabase Dashboard > Connect > Connection string > Direct
# Port 5432 is the direct connection. The session pooler (6543) is not used:
# it multiplexes over a single connection and breaks Laravel migrations.
# Never commit real values. Set them in the host environment.
# ---------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<your-project-ref>
DB_PASSWORD=
DB_SSLMODE=require

# Absolute production HTTPS base URL embedded inside generated
# student QR codes. MUST be the public domain (not an IP).
QR_URL=https://your-production-domain.example.com

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# No dedicated queue worker runs on Render, so jobs execute inline with the
# request. Appointment reminders are triggered by calling the
# /cron/reminders endpoint from a scheduler, not by the Laravel scheduler.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------
# Cron
# Shared secret required in the X-Cron-Secret header of /cron/reminders.
# Must match CRON_SECRET in render.yaml, which is generated by Render.
# ---------------------------------------------------------------
CRON_SECRET=

# Render terminates TLS at the edge; trust proxy headers so Laravel
# generates https URLs and rate-limit keys use the real client IP.
TRUSTED_PROXIES=*

# ---------------------------------------------------------------
# Mail
# Render's free tier blocks outbound SMTP (ports 25/465/587), so neither
# supported transport can use MAIL_HOST/MAIL_PORT. Both talk to a provider
# over HTTPS instead; pick one with MAIL_MAILER and fill in only that key.
#
#   brevo   - ACTIVE. 300 emails/day, 9,000/month, no card.
#             key: https://app.brevo.com -> Settings -> SMTP & API
#             MAIL_FROM_ADDRESS must be a sender verified under
#             Settings -> Senders. A gmail.com sender works, but Brevo
#             rewrites the visible from address because gmail.com cannot
#             be domain-authenticated.
#   resend  - 3,000 emails/month, 100/day. key: https://resend.com -> API Keys
#             Sends only from a verified domain, so MAIL_FROM_ADDRESS has
#             to stay onboarding@resend.dev until isufst.edu.ph is verified.
# ---------------------------------------------------------------
MAIL_MAILER=brevo
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_FROM_ADDRESS=isufstpass@gmail.com
MAIL_FROM_NAME="ISUFSTPASS"

# ---------------------------------------------------------------
# Supabase Storage (S3-compatible) - avatars
# Set AVATAR_DISK=supabase in production. Supabase dashboard:
#   Storage > Buckets (create "avatars") > S3 Access Keys (generate keys)
# ---------------------------------------------------------------
AVATAR_DISK=public
SUPABASE_PROJECT_REF=your-project-ref
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-southeast-1
S3_BUCKET=avatars
S3_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
S3_PUBLIC_URL=https://your-project-ref.supabase.co/storage/v1/object/public/avatars
S3_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="ISUFSTPASS"